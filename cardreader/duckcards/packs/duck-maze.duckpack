  "lessons": [
    {
      "title": "Plan on paper first",
      "skill": "Sequences",
      "body": "Draw the maze on squared paper. Draw the duck's path as one pencil line, then write a letter for each card along it: F, B, L, R. Only then lay out the cards and act the row out.",
      "ask": "Where did the pencil line and the cards disagree?"
    },
    {
      "title": "A duck that backs up",
      "skill": "Walk back",
      "body": "Play Back into the nest twice: once turning the duck round, once with Walk back. Count the steps both times. Then try Back out of the boathouse, where there is no room to turn.",
      "ask": "When is walking backward better than turning round?"
    },
    {
      "title": "Through the tunnel",
      "skill": "Gates",
      "body": "Make a tunnel from a shoebox with both ends cut off and stand it on its square. The duck has to walk through it the long way. Walking in from the side does not count, and neither does starting inside it.",
      "ask": "From which squares can the duck walk into the tunnel?"
    },
    {
      "title": "Bump!",
      "skill": "Debugging",
      "body": "When a row walks into a fence or off the board, the duck stops right there. Groups trade rows, act them out, and point to the card that bumped, without starting again from the beginning.",
      "ask": "How did you find the card that bumped?"
    },
    {
      "title": "Hello at the end",
      "skill": "Endings",
      "body": "Some challenges say how to finish: Hello at the pond, or a kick at the ball. That card goes last, after the duck has arrived, and it counts as a step.",
      "ask": "What happens if Hello comes before the duck gets there?"
    }
  ],
  "yours": []
}
